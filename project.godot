; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cartoon Terrain Studio"
config/description="Paint, generate and explore procedural 2.5D cartoon terrain: map painter, map generator and seeded open world with live material controls."
run/main_scene="res://scenes/Studio.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.0196, 0.0275, 0.0431, 1)
boot_splash/show_image=false

[autoload]

ComicRendering="*res://src/Comic/ComicRendering.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/energy_saving/keep_screen_on=false

[dotnet]

project/assembly_name="CartoonTerrainStudio"

[filesystem]

import/blender/enabled=false

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

; The Godot 4.6+ Windows default. The legacy Vulkan path lost the device during live zoom/streaming on AMD GPUs.
rendering_device/driver.windows="d3d12"
rendering_device/d3d12/max_sampler_descriptors=2048
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.0196, 0.0275, 0.0431, 1)
